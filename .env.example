# API root, including /api/v1. No credentials belong in this file.
# Used only by the Next.js server (may be an internal backend address).
LARAVEL_API_URL=http://localhost:8000/api/v1
# Browser-reachable URL; embedded at build time. Rebuild after changing it.
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000/api/v1
